# Secrets — never commit these.
# This file exists BEFORE any secrets file does, which is the point:
# reversed, a key ends up in the history permanently and deleting it later
# does nothing. Every credential it touched would have to be rotated.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
secrets*
*credentials*
service-role*

# Dependencies and build output
node_modules/
dist/
build/
.cache/

# Supabase CLI working files
.branches/
.temp/
supabase/.temp/

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
